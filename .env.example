# Copy to .env; .env is ignored by Git.
GROQ_API_KEY=
TINYFISH_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=16379
FALKORDB_GRAPH=just_chill_demo
# Local loopback-only development database; set a password for hosted use.
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# Scout-inspired discovery state (local disk must be persistent on a host).
# DISCOVERY_STATE_PATH=data/runtime/scout.sqlite3
DISCOVERY_DAILY_AI_CALLS=300
DISCOVERY_DAILY_FETCH_URLS=900
DISCOVERY_DAILY_SEARCHES=300
DISCOVERY_AI_TPM=8000
DISCOVERY_AI_MAX_OUTPUT_TOKENS=900
DISCOVERY_AI_OUTPUT_TPM=1000
DISCOVERY_AI_MAX_WAIT_SECONDS=65
DISCOVERY_AI_PAGE_CHARS=7000
DISCOVERY_BASIC_SECONDS=90
# Agent proof was authorized up to $3 total; no top-up/subscription authorized.
# Keep disabled until this account's hard max_steps support is verified.
TINYFISH_AGENT_ENABLED=false
TINYFISH_AGENT_MAX_STEPS=25
TINYFISH_AGENT_STEP_CAP_VERIFIED=false
# Default API runs are capped at 150 steps by the provider. Enable only after
# checking the application account's rate and reserving the full maximum cost.
TINYFISH_AGENT_DEFAULT_CAP_VERIFIED=false
TINYFISH_AGENT_STEP_COST_USD=0.016
DISCOVERY_AGENT_BUDGET_USD=3
# Recurring provider jobs are not authorized/enabled by default.
DISCOVERY_REFRESH_ENABLED=false
# Keep cached-example and policy-simulation routes off during normal use.
ENABLE_DEMO_TOOLS=false
# Progressive discovery enriches a bounded number of pages before target selection.
# Larger values consume more Groq quota; ceiling 36 pages, 240 seconds.
DISCOVERY_ENRICHMENT_PAGES=6
DISCOVERY_ENRICHMENT_SECONDS=150
